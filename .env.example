# ===================================================================
# MapRanker Pro — Environment Variables
# ===================================================================
# ⚠️ Only VITE_* variables are exposed to the frontend.
# API keys are now stored as Supabase Edge Function Secrets.
# ===================================================================

# 🔐 Supabase (Public — safe for frontend)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# 📍 White-Label Defaults
VITE_DEFAULT_COUNTRY=es
VITE_DEFAULT_LAT=40.4168
VITE_DEFAULT_LNG=-3.7038

# 🧪 Demo Mode (set to "true" to use simulated data without API keys)
VITE_DEMO_MODE=false

# ===================================================================
# 🛡️ API Keys — DO NOT add here. Configure as Supabase Secrets:
#
# supabase secrets set SERPER_API_KEY=xxx
# supabase secrets set OPENAI_API_KEY=xxx
# supabase secrets set DATAFORSEO_LOGIN=xxx
# supabase secrets set DATAFORSEO_PASSWORD=xxx
# supabase secrets set GOOGLE_MAPS_API_KEY=xxx
# ===================================================================
