# pnpm security and performance hardening
verify-store-integrity=true
strict-peer-dependencies=true
# Cooldown period for new packages (24 hours)
minimum-release-age=1440
# Only allow builds for trusted packages
# We will add specifically needed ones as they come up
# common for vite projects:
allow-builds-from=esbuild,swc,@swc/core,tailwindcss
